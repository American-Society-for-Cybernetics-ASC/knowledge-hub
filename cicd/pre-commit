#!/bin/sh
#
# Pre-commit git hook.
# To enable this hook, copy this file to ".git/hooks/".

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# Redirect output to stderr.
exec 1>&2

if ! uv run --directory backend ruff format -s --check; then
	echo "Pre-commit hook failed: ruff formatting error for backend"
	exit 1
fi

if ! uv run --directory backend ruff check -s; then
	echo "Pre-commit hook failed: python linting error for backend"
	exit 1
fi
