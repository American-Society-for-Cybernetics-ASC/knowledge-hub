# RSA Private Key
# Path to the RSA private key file used to sign JWT tokens
# Generate with: openssl genrsa -out private_key.pem 2048
RSA_PRIVATE_KEY_PATH=/path/to/private_key.pem

# Fernet Encryption Key
# Used to encrypt TOTP secrets before storing in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Database URL
# Connection string for PostgreSQL database
DATABASE_URL=postgresql://username:password@localhost:5432/ckh

# JWT Settings
JWT_ISSUER=ckh.asc-cybernetics.org
JWT_EXPIRY_MINUTES=10