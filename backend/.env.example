### Copy this file to .env for local development, or set these variables in your shell

### Uncomment this to test prod deployment behaviours.
# LOCAL_DEPLOYMENT=False

# This also gets used as the sending email
GOOGLE_USERNAME=example@gmail.com
# Configure an app password (https://support.google.com/accounts/answer/185833)
# This require 2FA
GOOGLE_PASSWORD=app-password

### Claude API
ANTHROPIC_API_KEY=api-key-here

### Default settings 
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
CLAUDE_SYSTEM_PROMPT_PATH=server/claude_interface/prompts/prompt.txt

### Database
SUPABASE_DATABASE_URL=postgresql://postgres.fqfmzdydomvykcsskiad:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
